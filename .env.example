# Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Models
GEMINI_MODEL=gemini-2.5-flash
# Alternatives: gemini-3.7-flash, gemini-2.5-flash-lite

# Embedding Model (Offline local sentence-transformers avoids consuming Gemini quota)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# API Server Settings
PORT=8000
HOST=0.0.0.0
