# Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Models
GEMINI_MODEL=gemini-3.6-flash
# Alternatives: gemini-3.7-flash, gemini-2.5-flash-lite

# Embedding Model (Offline local sentence-transformers avoids consuming Gemini quota)
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_INDEX_DIR=./data/rag_indexes

# Local scanned-PDF OCR (requires the Tesseract executable and matching language data)
OCR_LANGUAGE=eng
OCR_MIN_TEXT_CHARS=40
OCR_DPI=200
# Optional absolute paths; leave blank when the executable/data are already on PATH/default lookup.
TESSERACT_CMD=
TESSDATA_PREFIX=

# API Server Settings
PORT=8000
HOST=0.0.0.0
